# SPDX-License-Identifier: 0BSD
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C sources: the c-programming style with the kernel's indentation, hard tabs 8 columns wide.
[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 100

# Kbuild and Makefiles require hard tabs by language definition.
[{Kbuild,Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
tab_width = 8

[*.{json,py}]
indent_style = space
indent_size = 4

# Docs and metadata.
[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
