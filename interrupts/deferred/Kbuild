include $(KBUILD_EXTMOD)/scripts/profile.mk

# net_rx_softirq observes packets from a netfilter hook, and timer_softirq's
# bottom half is a timer_list callback; every other deferred sample drives a
# simulated IRQ.
ifdef CONFIG_IRQ_SIM
obj-m += tasklet.o
obj-m += bh_workqueue.o
obj-m += workqueue_sample.o
obj-m += threaded_irq.o
else
$(info => interrupts/deferred: tasklet, bh_workqueue, workqueue_sample and threaded_irq skipped, the kernel lacks CONFIG_IRQ_SIM)
endif
obj-m += timer_softirq.o
ifdef CONFIG_NETFILTER
obj-m += net_rx_softirq.o
else
$(info => interrupts/deferred/net_rx_softirq: skipped, the kernel lacks CONFIG_NETFILTER)
endif
